{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": {
      "*": "allow",
      "assh/**": "deny",
      "backup/**": "deny"
    }
  },
  "agent": {
    "pm": {
      "description": "产品经理 - 负责需求收集/定义，业务分析，业务推进/进度管理，边界审计，产品验收，协调调度",
      "mode": "primary",
      "model": "opencode/big-pickle",
      "temperature": 0.6,
      "steps": 50,
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "question": "allow",
        "todowrite": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "write": "ask",
        "edit": "ask",
        "bash": "ask",
        "task": "ask",
        "skill": "ask"
      }
    }
  }
}
